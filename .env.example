# Core
PYTHONUNBUFFERED=1
LOG_LEVEL=INFO

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=baseline-experiment
MLFLOW_PORT=5001
MLFLOW_S3_BUCKET=mlflow

# Registry and promotion gate
MODEL_NAME=breast-cancer-classifier
PROMOTION_MIN_F1=0.90

# Feast/Stores
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=feature_store
POSTGRES_USER=feast
POSTGRES_PASSWORD=feast
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Serving
SERVING_PORT=8000

# Drift
DRIFT_THRESHOLD=0.20
SLACK_WEBHOOK_URL=

# Feast
FEAST_REPO_PATH=feature_store/repo
