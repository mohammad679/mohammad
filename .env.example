POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=feature_store
POSTGRES_USER=feast
POSTGRES_PASSWORD=feast
REDIS_HOST=localhost
REDIS_PORT=6379

# Serving
SERVING_PORT=8000

# Drift
DRIFT_THRESHOLD=0.20
SLACK_WEBHOOK_URL=
